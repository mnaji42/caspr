<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Obligatoire dès lors que le hardened runtime est activé : sans cet
         entitlement, l'accès micro est refusé par le runtime lui-même, avant
         même que TCC intervienne. Aucun dialogue n'est présenté et l'app
         n'apparaît jamais dans Réglages › Confidentialité › Micro, ce qui
         rend la panne indétectable côté utilisateur. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Volontairement PAS de com.apple.security.app-sandbox : Caspr doit
         insérer du texte dans d'autres applications, ce que le bac à sable
         interdit. -->
</dict>
</plist>
